# Cureva Care backend — environment (example). Copy to backend/.env.
# SECRETS LIVE HERE, NEVER IN platform_settings AND NEVER COMMITTED
# (cureva-docs/07-security-privacy-access.md). .env is gitignored.

# --- Core ---
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (local dev: the isolated Cureva Postgres container on 5434) ---
DATABASE_URL=postgres://cureva:cureva_dev_pw@127.0.0.1:5434/cureva

# --- Frontend origin (CORS + magic-link / SSO redirect targets) ---
FRONTEND_ORIGIN=http://localhost:3100

# --- Email (magic-link). Dev default: console backend prints the link. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@cureva.care
# For a real SMTP provider, set these and switch EMAIL_BACKEND to smtp:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# --- Google SSO (OAuth2 / OIDC). Supply real credentials to test end-to-end. ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Vision/OCR provider — extraction (Module 2) ---
# Provider is swappable (open decision #8). EXTRACTION_PROVIDER: auto|openai|claude.
# 'auto' prefers OpenAI when OPENAI_API_KEY is set, else Claude.
EXTRACTION_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# --- Termii SMS (Module 6) ---
TERMII_API_KEY=
TERMII_SENDER_ID=Cureva

# --- Object storage (MinIO in dev; S3-compatible) ---
S3_ENDPOINT_URL=http://127.0.0.1:9102
S3_ACCESS_KEY=cureva
S3_SECRET_KEY=cureva_dev_pw
S3_BUCKET=cureva-sources
S3_REGION=us-east-1
